{
  "name": "nextcloud-open-local",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Browser extension that opens the Nextcloud file you are looking at in the local desktop app, using the copy the Nextcloud desktop client keeps in sync",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test --path-ignore-patterns '**/*.e2e.ts'",
    "build": "bun run scripts/build.ts",
    "package": "bun run build && bun run scripts/package.ts",
    "test:e2e": "bun test ./tests/e2e/extension.e2e.ts",
    "screenshots": "bun run scripts/screenshots/capture.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.4",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
